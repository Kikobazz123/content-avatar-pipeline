#!/usr/bin/env python3
"""Burn-in caption generator — produces an ASS subtitle file with the
karaoke word-highlight style used by the top-performing shorts in this niche
(bold uppercase, heavy outline, one word accented at a time).

Timings come from faster-whisper word timestamps, so captions land on the
actual audio rather than an estimate. Runs on CPU; the `base` model is the
default because this machine has 5.9 GB of RAM (see memory/workstation-hardware-ceiling).

Usage:
    python captions.py VOICEOVER.wav -o captions.ass
    python captions.py clip.mp4 -o captions.ass --words-per-line 4 --model small
    python captions.py vo.wav -o captions.ass --script script.txt   # force exact wording
"""
from __future__ import annotations
import argparse
import os
import sys

# ASS colours are &HAABBGGRR (alpha, blue, green, red) — not RGB.
WHITE = "&H00FFFFFF"
CYAN = "&H00FFFF00"
OUTLINE = "&H00000000"

HEADER = """[Script Info]
ScriptType: v4.00+
PlayResX: {w}
PlayResY: {h}
WrapStyle: 2
ScaledBorderAndShadow: yes

[V4+ Styles]
Format: Name, Fontname, Fontsize, PrimaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
Style: Cap,{font},{size},{white},{outline},{outline},-1,0,0,0,100,100,0,0,1,{border},0,8,60,60,{margin},1

[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
"""


def ts(t: float) -> str:
    """Seconds -> ASS H:MM:SS.cc"""
    if t < 0:
        t = 0.0
    h = int(t // 3600)
    m = int(t % 3600 // 60)
    s = t % 60
    return f"{h:d}:{m:02d}:{s:05.2f}"


def transcribe(src: str, model_name: str, lang: str | None):
    """Word-level timings. int8 on CPU keeps memory in range on low-RAM boxes."""
    try:
        from faster_whisper import WhisperModel
    except ImportError:
        sys.exit("faster-whisper missing. Install: pip install 'claude-real-video[fast]'")
    model = WhisperModel(model_name, device="cpu", compute_type="int8")
    segments, _info = model.transcribe(
        src, word_timestamps=True, vad_filter=True,
        language=None if (lang in (None, "auto")) else lang,
    )
    words = []
    for seg in segments:
        for w in (seg.words or []):
            text = w.word.strip()
            if text:
                words.append((w.start, w.end, text))
    return words


def realign(words, script_path: str):
    """Replace recognised wording with the real script, keeping ASR timings.

    Whisper mishears accented speech (it mangled both reference videos badly),
    but its *timing* stays usable. When you know what was actually said, this
    keeps the rhythm and fixes the words — captions that are confidently wrong
    are worse than none, because viewers read them as your writing.
    """
    with open(script_path, encoding="utf-8") as f:
        target = f.read().split()
    if not target:
        return words
    if len(target) == len(words):
        return [(s, e, t) for (s, e, _), t in zip(words, target)]
    # Counts differ — distribute the script across the spoken span proportionally.
    start, end = words[0][0], words[-1][1]
    step = (end - start) / len(target)
    return [(start + i * step, start + (i + 1) * step, t)
            for i, t in enumerate(target)]


def build(words, args) -> str:
    out = [HEADER.format(w=args.width, h=args.height, font=args.font, size=args.font_size,
                         white=WHITE, outline=OUTLINE, border=args.border,
                         margin=args.margin_v)]
    n = args.words_per_line
    for i in range(0, len(words), n):
        group = words[i:i + n]
        for j, (ws, we, _) in enumerate(group):
            # Whole line stays on screen; only the active word changes colour.
            parts = []
            for k, (_, _, text) in enumerate(group):
                t = text.upper() if args.uppercase else text
                t = t.replace("{", "(").replace("}", ")")  # ASS override guards
                parts.append(f"{{\\c{CYAN}}}{t}{{\\c{WHITE}}}" if k == j else t)
            line = " ".join(parts)
            # Hold the last word of a group until the next group starts.
            end = group[j + 1][0] if j + 1 < len(group) else we
            if end <= ws:
                end = ws + 0.12
            out.append(f"Dialogue: 0,{ts(ws)},{ts(end)},Cap,,0,0,0,,{line}")
    return "\n".join(out) + "\n"


def main() -> None:
    p = argparse.ArgumentParser(description="Karaoke-style burn-in captions (.ass)")
    p.add_argument("source", help="voiceover audio or a video file")
    p.add_argument("-o", "--out", default="captions.ass")
    p.add_argument("--script", help="text file of what was actually said — fixes ASR mishearing")
    p.add_argument("--model", default="base", help="faster-whisper model (base/small/medium)")
    p.add_argument("--lang", default="en")
    p.add_argument("--words-per-line", type=int, default=4)
    p.add_argument("--font", default="Arial Black")
    p.add_argument("--font-size", type=int, default=78)
    p.add_argument("--border", type=int, default=6, help="outline thickness")
    p.add_argument("--width", type=int, default=1080)
    p.add_argument("--height", type=int, default=1920)
    p.add_argument("--margin-v", type=int, default=420,
                   help="distance from top (alignment is top-centre)")
    p.add_argument("--no-uppercase", dest="uppercase", action="store_false")
    args = p.parse_args()

    if not os.path.exists(args.source):
        sys.exit(f"not found: {args.source}")

    words = transcribe(args.source, args.model, args.lang)
    if not words:
        sys.exit("No speech detected — nothing to caption.")
    if args.script:
        words = realign(words, args.script)

    with open(args.out, "w", encoding="utf-8") as f:
        f.write(build(words, args))
    print(f"{args.out}  ({len(words)} words, {words[-1][1]:.1f}s)")


if __name__ == "__main__":
    main()
